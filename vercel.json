{
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    },
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    }
   ]
  },
  {
   "source": "/api/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-store"
    }
   ]
  }
 ]
}